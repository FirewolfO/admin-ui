[Unit]
Description=Admin UI
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/code/admin-ui
Environment=VITE_PERMISSION_API_BASE_URL=/api/permission/v1
Environment=VITE_GATEWAY_ADMIN_API_BASE_URL=/api/gateway-admin/v1
Environment=VITE_BLOG_API_BASE_URL=/api/blog/v1
Environment=VITE_PERMISSION_PROXY_TARGET=http://127.0.0.1:8081
Environment=VITE_GATEWAY_ADMIN_PROXY_TARGET=http://127.0.0.1:8083
Environment=VITE_BLOG_PROXY_TARGET=http://127.0.0.1:8086
Environment=VITE_AI_WORKBENCH_PROXY_TARGET=http://127.0.0.1:8087
Environment=VITE_PEOPLE_LOGIN_ORIGIN=http://10.251.237.216:5177
Environment=VITE_PEOPLE_UI_URL=http://10.251.237.216:5177/profile
Environment=VITE_OAUTH_REDIRECT_URI=http://10.251.237.216:5178/oauth/callback
ExecStartPre=/usr/bin/node %h/code/admin-ui/node_modules/vite/bin/vite.js build
ExecStart=/usr/bin/node %h/code/admin-ui/deploy/serve.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
